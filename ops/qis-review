#!/usr/bin/env bash
# Hourly-review bookkeeping (project.md Section 12). Not a scheduler: the Claude session's
# CronCreate job fires the review; this script records ownership, lock, and timestamps.
#   ops/qis-review begin   -> takes the lock, reports whether the review was overdue
#   ops/qis-review end     -> records last successful review and next due time, frees the lock
#   ops/qis-review status  -> prints the record and "OVERDUE" when the next due time has passed
set -euo pipefail
HERE=$(cd "$(dirname "$0")/.." && pwd)
REC="$HERE/ops/review-state.json"; LOCK="$HERE/slurm-agentic-engineering/.qis-review.lock"
now=$(date -u +%s)
get() { python3 -c "import json,sys;print(json.load(open('$REC')).get('$1',''))" 2>/dev/null || true; }
put() { python3 - "$@" <<'PY'
import json,sys,os
rec=sys.argv[1]; d=json.load(open(rec)) if os.path.exists(rec) else {}
for kv in sys.argv[2:]:
    k,v=kv.split('=',1); d[k]=v
d.setdefault('owner','qwen-interference-study orchestrator (Claude Code session on laptop; CronCreate hourly job)')
json.dump(d,open(rec,'w'),indent=1,sort_keys=True); open(rec,'a').write('\n')
PY
}
iso() { date -u -r "$1" +%FT%TZ; }
case "${1:-status}" in
  begin)
    mkdir "$LOCK" 2>/dev/null || { echo "review lock held: $LOCK"; exit 3; }
    due=$(get next_due_epoch); over=no; [ -n "$due" ] && [ "$now" -gt $((due + 900)) ] && over=yes
    put "$REC" "started=$(iso $now)" "missed_previous=$over"; echo "review begin $(iso $now) overdue=$over";;
  end)
    put "$REC" "last_success=$(iso $now)" "next_due=$(iso $((now+3600)))" "next_due_epoch=$((now+3600))"
    rmdir "$LOCK" 2>/dev/null || true; echo "review end $(iso $now); next due $(iso $((now+3600)))";;
  status)
    cat "$REC" 2>/dev/null || echo "no review record"
    due=$(get next_due_epoch); [ -n "$due" ] && [ "$now" -gt "$due" ] && echo "OVERDUE since $(iso $due)" || true;;
esac
