# Runtime settings of study Nov-15-2026-02-vineeth-babel-slurm-interference-dynamics (CMU Babel Slurm).
# Use on a Babel compute node: set -a; source envs/Nov-15-2026-02-vineeth-babel-slurm-interference-dynamics/babel-slurm.env; set +a
# Package lock: pip-freeze.txt in this folder (copied from study 00; the build job records the installed freeze).
PYTHON_VERSION=3.12
# /data/user_data mounts on compute nodes only; never put envs, models or checkpoints in /home.
PROJ_DATA=/data/user_data/$USER/qis
S02=$PROJ_DATA/s02
VENV=$PROJ_DATA/env/venv-s02
HF_HOME=$PROJ_DATA/hf
UV_CACHE_DIR=$PROJ_DATA/uvcache
HF_HUB_OFFLINE=1
PYTHONPATH=src
# Model pinned for the study (Qwen3-1.7B, non-thinking chat template: enable_thinking=False).
MODEL_ID=Qwen/Qwen3-1.7B
MODEL_REVISION=70d244cc86ccca08cf5af4e1e306ecf908b1ad5e
MODEL=$PROJ_DATA/hf/hub/models--Qwen--Qwen3-1.7B/snapshots/70d244cc86ccca08cf5af4e1e306ecf908b1ad5e
VLLM_ENABLE_V1_MULTIPROCESSING=0
VLLM_USE_FLASHINFER_SAMPLER=0
