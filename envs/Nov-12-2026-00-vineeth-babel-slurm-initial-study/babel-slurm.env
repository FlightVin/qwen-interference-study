# Runtime settings of the study Nov-12-2026-00-vineeth-babel-slurm-initial-study (CMU Babel Slurm).
# Use on a Babel compute node: set -a; source envs/Nov-12-2026-00-vineeth-babel-slurm-initial-study/babel-slurm.env; set +a
# Package lock of this environment: envs/Nov-12-2026-00-vineeth-babel-slurm-initial-study/pip-freeze.txt
PYTHON_VERSION=3.12
# Babel storage: /data/user_data mounts on compute nodes only; never put envs, models or checkpoints in /home.
PROJ_DATA=/data/user_data/$USER/qis
VENV=$PROJ_DATA/env/venv-v1
HF_HOME=$PROJ_DATA/hf
UV_CACHE_DIR=$PROJ_DATA/uvcache
HF_HUB_OFFLINE=1
PYTHONPATH=src
# Model pinned for the study (Qwen3-1.7B, non-thinking chat template).
MODEL_ID=Qwen/Qwen3-1.7B
MODEL_REVISION=70d244cc86ccca08cf5af4e1e306ecf908b1ad5e
MODEL=$PROJ_DATA/hf/hub/models--Qwen--Qwen3-1.7B/snapshots/70d244cc86ccca08cf5af4e1e306ecf908b1ad5e
# vLLM settings used by every training and evaluation job.
VLLM_ENABLE_V1_MULTIPROCESSING=0
VLLM_USE_FLASHINFER_SAMPLER=0
# Study data in this repository.
DATA_DIR=data/Nov-12-2026-00-vineeth-babel-slurm-initial-study
