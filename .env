# Python environment for this repository. No secrets belong here.
# Setup (see README.md): create a Python 3.12 venv, install the pinned packages, then `set -a; source .env; set +a`.
# Versions are the ones recorded on 2026-11-12 (Linux, CUDA 13.0, one 48 GB GPU per job).
PYTHON_VERSION=3.12
VENV_DIR=.venv
PIP_PACKAGES="verl[vllm]==0.9.0 vllm==0.31.0 torch==2.13.0 transformers==5.10.4 math-verify[antlr4_13_2]==0.9.0 datasets==5.1.0 numpy==2.3.5 omegaconf>=2.3,<2.5 ninja pytest wandb"
# Plotting and report builds only (CPU, any OS):
PIP_PACKAGES_REPORTS="matplotlib numpy pillow"
PYTHONPATH=src
# Model and data locations. Override on clusters (for example, put HF_HOME on large compute storage).
MODEL_ID=Qwen/Qwen3-1.7B
MODEL_REVISION=70d244cc86ccca08cf5af4e1e306ecf908b1ad5e
HF_HOME=.cache/huggingface
DATA_DIR=data/Nov-12-2026-qwen3-grpo-math-practice
VLLM_ENABLE_V1_MULTIPROCESSING=0
VLLM_USE_FLASHINFER_SAMPLER=0
